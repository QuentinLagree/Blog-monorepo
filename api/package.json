{
  "name": "blog-api",
  "version": "0.0.1",
  "description": "API de blog NestJS, Fastify et Prisma",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.{ts,cjs}\" \"*.{json,cjs,ts}\"",
    "check:tests": "pnpm run format:check && pnpm run lint",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.{ts,cjs}\" \"*.{json,cjs,ts}\"",
    "start": "nest start -b swc -w --type-check",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src scripts --no-fix",
    "test:unit": "pnpm run check:tests && dotenv -e .env.test -- jest",
    "test:watch": "pnpm run check:tests && dotenv -e .env.test -- jest --watch",
    "test:cov": "pnpm run check:tests && dotenv -e .env.test -- jest --coverage",
    "test:e2e": "pnpm run check:tests && dotenv -e .env.test -- jest --config src/test/e2e/jest-e2e.json",
    "test:e2e:watch": "pnpm run check:tests && dotenv -e .env.test -- jest --config src/test/e2e/jest-e2e.json --watch",
    "test:e2e:cov": "pnpm run check:tests && dotenv -e .env.test -- jest --config src/test/e2e/jest-e2e.json --coverage",
    "test:db:push": "dotenv -e .env.test -- prisma db push --schema src/config/database/schema.merged.prisma",
    "test:db:studio": "dotenv -e .env.test -- prisma studio --schema src/config/database/schema.merged.prisma",
    "test:all": "pnpm run check:tests && dotenv -e .env.test -- node scripts/test-all.cjs",
    "prisma:build": "node scripts/merge-prisma.cjs && prisma format --schema src/config/database/schema.merged.prisma",
    "prisma:validate": "prisma validate --schema src/config/database/schema.merged.prisma",
    "prisma:generate": "prisma generate --schema src/config/database/schema.merged.prisma",
    "prisma:migrate": "prisma migrate dev --schema src/config/database/schema.merged.prisma",
    "prisma:deploy": "node scripts/check-pseudo-duplicates.cjs && prisma migrate deploy --schema src/config/database/schema.merged.prisma",
    "prisma:studio": "prisma studio --schema src/config/database/schema.merged.prisma",
    "prisma:seed": "tsx src/config/database/seeds/seeds.ts",
    "lint:fix": "eslint src scripts --fix",
    "typecheck": "tsc --noEmit --project tsconfig.build.json",
    "prisma:check-duplicates": "node scripts/check-pseudo-duplicates.cjs",
    "logs": "dotenv -e .env -- tsx src/commons/logger/logs.cli.ts",
    "logs:prod": "node dist/commons/logger/logs.cli.js",
    "logs:list": "pnpm run logs list",
    "logs:check": "pnpm run logs check",
    "logs:show": "pnpm run logs show",
    "logs:search": "pnpm run logs search",
    "logs:archive": "pnpm run logs archive",
    "logs:pin": "pnpm run logs pin",
    "logs:pins": "pnpm run logs pins",
    "logs:unpin": "pnpm run logs unpin",
    "logs:download": "pnpm run logs download",
    "logs:export": "pnpm run logs export",
    "logs:delete": "pnpm run logs delete"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/secure-session": "^8.1.1",
    "@fastify/static": "^8.0.4",
    "@golevelup/ts-jest": "^0.6.2",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/common": "^11.0.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.7",
    "@nestjs/platform-express": "^11.0.7",
    "@nestjs/platform-fastify": "^11.0.7",
    "@nestjs/swagger": "^11.0.3",
    "@prisma/client": "^6.14.0",
    "@types/helmet": "^4.0.0",
    "@types/randomstring": "^1.3.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.63.0",
    "chalk": "^5.4.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "fastify": "^5.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "nodemailer": "^7.0.3",
    "proper-lockfile": "4.1.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "slugify": "^1.6.6",
    "sodium-native": "5.0.9",
    "swagger-ui-express": "^5.0.1",
    "tar": "7.5.23",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.7",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.12",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/proper-lockfile": "4.1.4",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "glob": "^11.0.2",
    "jest": "^29.7.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.14.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "sodium-native",
      "@swc/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}

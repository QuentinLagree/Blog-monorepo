model User {
  id       Int    @id @default(autoincrement())
  nom      String
  prenom   String
  pseudo   String @unique
  email    String @unique
  password String
  role     String

  posts   Post[]
  likes   Like[]
  postReads PostRead[]
  preference UserPreference?
  recoveryToken VerificationTokens?


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("user")
}

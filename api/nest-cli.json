{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "swc",
      "options": {
        "ignore": ["**/test/**"]
      }
    },
    "typeCheck": true,
    "assets": [
      {
        "include": "commons/mailing/mail/templates/**/*",
        "watchAssets": true
      }
    ],
    "watchAssets": true
  }
}
